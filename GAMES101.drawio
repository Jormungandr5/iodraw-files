  <diagram name="第 1 页" id="JKm8eNT5LhcCvcYsY2wh">
    <mxGraphModel dx="1110" dy="1905" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fBmv-VpW1MZZ_E2-W35G-2" parent="1" style="triangle;whiteSpace=wrap;html=1;shapeInside=1;" value="" vertex="1">
          <mxGeometry height="110" width="480" x="170" y="50" as="geometry" />
        </mxCell>
        <mxCell id="fBmv-VpW1MZZ_E2-W35G-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;i&gt;&lt;u&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Triangle：&lt;/font&gt;&lt;/u&gt;&lt;/i&gt;&lt;/b&gt;&lt;div style=&quot;text-decoration-line: inherit;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;1. Vector4f v[3] - 齐次坐标下三个顶点坐标&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-decoration-line: inherit;&quot;&gt;&lt;span style=&quot;text-decoration-line: inherit; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;2. Vector3f color[3] - 三个顶点对应的color&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-decoration-line: inherit; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;3.Vector2f text_coords[3] - 三个顶点的uv坐标&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;4. Vector3f normal[3] - 三个顶点位置的法向量&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="376" x="170" y="40" as="geometry" />
        </mxCell>
        <mxCell id="fBmv-VpW1MZZ_E2-W35G-6" connectable="0" parent="1" style="group;fontSize=17;" value="" vertex="1">
          <mxGeometry height="120" width="250" x="230" y="-120" as="geometry" />
        </mxCell>
        <mxCell id="fBmv-VpW1MZZ_E2-W35G-1" parent="fBmv-VpW1MZZ_E2-W35G-6" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;从.obj文件中读取&lt;b style=&quot;&quot;&gt;&lt;i&gt;&lt;u&gt;&lt;font style=&quot;&quot;&gt;mesh&lt;/font&gt;&lt;/u&gt;&lt;/i&gt;&lt;/b&gt;,然后从mesh中读取Triangle的数据，生成新的三角形，假如TriangleList&lt;/font&gt;" vertex="1">
          <mxGeometry height="86.66666666666666" width="250" y="33.33333333333333" as="geometry" />
        </mxCell>
        <mxCell id="fBmv-VpW1MZZ_E2-W35G-5" parent="fBmv-VpW1MZZ_E2-W35G-6" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value=".obj文件" vertex="1">
          <mxGeometry height="40" width="65.21739130434783" x="84.78260869565217" as="geometry" />
        </mxCell>
        <mxCell id="fBmv-VpW1MZZ_E2-W35G-7" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="160" width="230" x="720" y="20" as="geometry" />
        </mxCell>
        <mxCell id="fBmv-VpW1MZZ_E2-W35G-8" parent="fBmv-VpW1MZZ_E2-W35G-7" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=17;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;对每个fragment，其中存储了：&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1. 插值颜色；&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2. 插值法向量；&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;3. 插值uv坐标；&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;4. 绑定的纹理&lt;b&gt;&lt;i&gt;&lt;u&gt;Texture&lt;/u&gt;&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="230" y="50" as="geometry" />
        </mxCell>
        <mxCell id="fBmv-VpW1MZZ_E2-W35G-9" parent="fBmv-VpW1MZZ_E2-W35G-7" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;" value="&lt;b&gt;&lt;i&gt;&lt;u&gt;fragment_shader_payload&lt;/u&gt;&lt;/i&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="230" y="20" as="geometry" />
        </mxCell>
        <mxCell id="fBmv-VpW1MZZ_E2-W35G-10" connectable="0" parent="1" style="group;fontSize=18;" value="" vertex="1">
          <mxGeometry height="160" width="420" x="720" y="-180" as="geometry" />
        </mxCell>
        <mxCell id="fBmv-VpW1MZZ_E2-W35G-11" parent="fBmv-VpW1MZZ_E2-W35G-10" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=17;" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;1.从.jpg文件中读取纹理&lt;b&gt;&lt;i&gt;&lt;u&gt;Texture&lt;/u&gt;&lt;/i&gt;&lt;/b&gt;，并记录；&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;运行时传给fragment_shader_payload；&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;2.用active_shader中记录的shader函数，接收参数fragement_shader_payload，对fragment进行shading计算pixel&lt;/span&gt;&lt;/div&gt;" vertex="1">
