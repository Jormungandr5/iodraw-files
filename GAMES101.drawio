        <mxCell id="fBmv-VpW1MZZ_E2-W35G-15" parent="fBmv-VpW1MZZ_E2-W35G-14" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontSize=17;" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;是一个函数容器，指向要执行的shader函数（不同的shading模型有不同的shader函数）&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="302" x="-46" y="50" as="geometry" />
